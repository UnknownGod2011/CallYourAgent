# CallYourAgent server auth. Generate a long random value.
CYA_API_TOKEN=

# Runtime selection: fake|calle and memory|sqlite
CYA_CALL_PROVIDER=fake
CYA_STORE=sqlite
CYA_SQLITE_PATH=callyouragent.db
PORT=8787

# Agent -> owner decision-call policy. Low-priority escalations below the minimum
# remain durable/pending without placing a phone side effect.
CYA_MIN_DECISION_PRIORITY=normal
CYA_MAX_DECISION_CALLS_PER_RUN=5
CYA_MAX_DECISION_CALLS_PER_OWNER_24H=12

# Optional quiet hours. Configure all three together. Hours are 0-23 in the
# specified IANA timezone. Critical escalations bypass by default.
CYA_QUIET_HOURS_START=22
CYA_QUIET_HOURS_END=7
CYA_QUIET_HOURS_TIME_ZONE=Asia/Kolkata
CYA_QUIET_HOURS_BYPASS_PRIORITY=critical

# Base URL consumed by the local/stdin MCP adapter. Point this at the running
# CallYourAgent HTTP control plane; the MCP process never receives CALLE_API_KEY.
CYA_BASE_URL=http://127.0.0.1:8787

# Required only when CYA_CALL_PROVIDER=calle.
# Keep all values server-side; never expose them to browser/client bundles.
CALLE_API_KEY=
CALLE_BASE_URL=https://api.heycall-e.com
CYA_OWNER_PHONE=

# Public HTTPS base URL of this server, e.g. https://agent.example.com
CYA_PUBLIC_BASE_URL=

# Secret embedded only in the CALL-E webhook URL because current CALL-E terminal
# webhooks are unsigned. The receiver ALSO requires CALL-E-Event-Id to match body.id.
CYA_CALLE_WEBHOOK_TOKEN=
